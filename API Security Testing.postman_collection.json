  "item": [
    {
      "name": "01 - BOLA (IDOR) Testing",
      "item": [
        {
          "name": "Request 1 - User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"User A Authenticated\", function () {\r\n    pm.response.to.have.status(201);\r\n    // Giả lập lưu token của User A (UserId = 1)\r\n    pm.collectionVariables.set(\"attacker_token\", \"Bearer token-user-1-abc\");\r\n    pm.collectionVariables.set(\"attacker_id\", 1);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"attacker\",\r\n  \"userId\": 1\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/posts",
              "protocol": "https",
              "host": [
                "jsonplaceholder",
                "typicode",
                "com"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Request 2 - User B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Resource belongs to another user (Victim)\", function () {\r\n    pm.response.to.have.status(200);\r\n    const data = pm.response.json();\r\n    // Lưu ID bài viết của nạn nhân\r\n    pm.collectionVariables.set(\"victim_post_id\", data.id);\r\n    pm.collectionVariables.set(\"victim_user_id\", data.userId);\r\n\r\n    // Kiểm tra chắc chắn tài nguyên này không phải của User A\r\n    pm.expect(data.userId).to.not.eql(pm.collectionVariables.get(\"attacker_id\"));\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/posts/2",
              "protocol": "https",
              "host": [
                "jsonplaceholder",
                "typicode",
                "com"
              ],
              "path": [
                "posts",
                "2"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Exploit Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Security Gate: System must block unauthorized update (BOLA/IDOR check)\", function () {\r\n    // Trong môi trường an toàn, backend bắt buộc phải trả về 403 Forbidden\r\n    // Nếu trả về 200/204 nghĩa là dính lỗi BOLA\r\n    pm.expect(pm.response.code).to.be.oneOf([403, 401]);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "{{attacker_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"id\": {{victim_post_id}},\r\n  \"title\": \"Hacked by User 1\",\r\n  \"body\": \"Tampered content\",\r\n  \"userId\": {{victim_user_id}}\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/posts/){{victim_post_id}}",
              "protocol": "https",
              "host": [
                "jsonplaceholder",
                "typicode",
                "com"
              ],
              "path": [
                "posts",
                "){{victim_post_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Mass Assignment Testing",
      "item": [
        {
          "name": "Security - Mass Assignment Exploit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Security Gate: System must strip or reject unauthorized privilege escalation fields\", function () {\r\n    const res = pm.response.json();\r\n\r\n    // Kiểm tra các trường nhạy cảm không được phép tồn tại trong dữ liệu lưu trữ\r\n    pm.expect(res).to.not.have.property(\"role\", \"admin\");\r\n    pm.expect(res).to.not.have.property(\"is_admin\", true);\r\n    pm.expect(res).to.not.have.property(\"balance\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"Standard User\",\r\n  \"username\": \"std_user\",\r\n  \"email\": \"user@example.com\",\r\n  \"role\": \"admin\",\r\n  \"is_admin\": true,\r\n  \"balance\": 1000000\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/users",
              "protocol": "https",
              "host": [
                "jsonplaceholder",
                "typicode",
                "com"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Broken Authentication Testing",
      "item": [
        {
          "name": "Security - Tampered Token Verification",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Security Gate: Server must reject forged/tampered tokens with 401 Unauthorized\", function () {\r\n    // Hệ thống an toàn bắt buộc phải từ chối token không hợp lệ bằng mã 401\r\n    pm.expect(pm.response.code).to.eql(401);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer this-is-a-fake-and-forged-token-xyz"
              }
            ],
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/posts/1",
              "protocol": "https",
              "host": [
                "jsonplaceholder",
                "typicode",
                "com"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Security - Missing Auth Header Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Security Gate: Server must reject requests missing Authorization header with 401 Unauthorized\", function () {\r\n    // Hệ thống an toàn bắt buộc phải từ chối truy cập và trả về mã HTTP 401\r\n    pm.expect(pm.response.code).to.eql(401);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/posts/1",
              "protocol": "https",
              "host": [
                "jsonplaceholder",
