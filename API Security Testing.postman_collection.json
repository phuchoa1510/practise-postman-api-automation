    {
      "name": "05 - Security Misconfiguration",
      "item": [
        {
          "name": "Security - Headers & Fingerprinting Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// 1. Kiểm tra rò rỉ công nghệ Backend (Server Fingerprinting)\r\npm.test(\"Security Gate: Server must not expose backend technology via X-Powered-By\", function () {\r\n    pm.expect(pm.response.headers.has(\"X-Powered-By\")).to.be.false;\r\n});\r\n\r\n// 2. Kiểm tra header chống đánh hơi loại nội dung (MIME Sniffing)\r\npm.test(\"Security Gate: System should include X-Content-Type-Options: nosniff\", function () {\r\n    pm.expect(pm.response.headers.get(\"X-Content-Type-Options\")).to.eql(\"nosniff\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/posts/1",
              "protocol": "https",
              "host": [
                "jsonplaceholder",
                "typicode",
                "com"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 - Rate Limiting Testing",
      "item": [
        {
          "name": "Security - Rate Limit Bypass Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.variables.get(\"request_count\")) {\r\n    pm.variables.set(\"request_count\", 1);\r\n}\r\nlet count = Number(pm.variables.get(\"request_count\"));\r\nconst maxAttempts = 15; // Thử nghiệm gửi 15 request dồn dập\r\n\r\npm.test(`Attempt ${count}: System should enforce Rate Limiting (HTTP 429)`, function () {\r\n    if (count >= 10) {\r\n        // Từ request thứ 10 trở đi, kỳ vọng server phải chặn lại bằng mã 429\r\n        pm.expect(pm.response.code).to.eql(429);\r\n    } else {\r\n        // Các request ban đầu được phép thành công\r\n        pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r\n    }\r\n});\r\n\r\n// Tự động lặp lại chính request này cho đến khi đủ số lượng\r\nif (count < maxAttempts) {\r\n    pm.variables.set(\"request_count\", count + 1);\r\n    postman.setNextRequest(\"Security - Rate Limit Bypass Check\");\r\n} else {\r\n    pm.variables.unset(\"request_count\");\r\n    postman.setNextRequest(null); // Dừng chuỗi test\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"title\": \"Flooding test\",\r\n  \"body\": \"Rate limit verification\",\r\n  \"userId\": 1\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/posts",
              "protocol": "https",
              "host": [
                "jsonplaceholder",
                "typicode",
                "com"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "response": []
        }
      ]
    }
