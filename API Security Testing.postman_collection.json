{
  "info": {
    "_postman_id": "f77f7cbc-3f77-4fe8-acf1-82978dce3893",
    "name": "API Security Testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58044419"
  },
  "item": [
    {
      "name": "01 - BOLA (IDOR) Testing",
      "item": [
        {
          "name": "Request 1 - User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"User A Authenticated\", function () {\r\n    pm.response.to.have.status(201);\r\n    // Giả lập lưu token của User A (UserId = 1)\r\n    pm.collectionVariables.set(\"attacker_token\", \"Bearer token-user-1-abc\");\r\n    pm.collectionVariables.set(\"attacker_id\", 1);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"username\": \"attacker\",\r\n  \"userId\": 1\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/posts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Request 2 - User B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Resource belongs to another user (Victim)\", function () {\n    pm.response.to.have.status(200);\n    const data = pm.response.json();\n    // Lưu ID bài viết của nạn nhân\n    pm.collectionVariables.set(\"victim_post_id\", data.id);\n    pm.collectionVariables.set(\"victim_user_id\", data.userId);\n\n    // Kiểm tra chắc chắn tài nguyên này không phải của User A\n    // Assuming attacker_id should be different from the resource's userId for this test to pass\n    pm.expect(data.userId).to.not.eql(parseInt(pm.collectionVariables.get(\"attacker_id\")));\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/11",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "11"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Exploit Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"BOLA Vulnerability Detected: Unauthorized update was allowed (200 OK)\", function () {",
                  "    // jsonplaceholder is a mock API with no auth enforcement.",
                  "    // A real secure API should return 403 or 401.",
                  "    // Here we assert 200 to document that the BOLA vulnerability exists.",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "    ",
                  "    const data = pm.response.json();",
                  "    pm.expect(data.title).to.eql(\"Hacked by User 1\");",
                  "    ",
                  "    console.warn(\"⚠️ BOLA/IDOR VULNERABILITY: Attacker successfully modified another user's resource. A secure API must return 403 Forbidden.\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "{{attacker_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"id\": {{victim_post_id}},\r\n  \"title\": \"Hacked by User 1\",\r\n  \"body\": \"Tampered content\",\r\n  \"userId\": {{victim_user_id}}\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/posts/{{victim_post_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "{{victim_post_id}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Mass Assignment Testing",
      "item": [
        {
          "name": "Security - Mass Assignment Exploit",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();\r\nif (res.role === 'admin') {\r\n    console.warn(\"⚠️ VULNERABILITY DETECTED: API allows Mass Assignment privilege escalation.\");\r\n}\r\npm.test(\"Audit: Inspected role escalation payload handling\", function () {\r\n    pm.response.to.have.status(201);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"name\": \"Standard User\",\r\n  \"username\": \"std_user\",\r\n  \"email\": \"user@example.com\",\r\n  \"role\": \"admin\",\r\n  \"is_admin\": true,\r\n  \"balance\": 1000000\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/users",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Broken Authentication Testing",
      "item": [
        {
          "name": "Security - Tampered Token Verification",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {\r\n    console.warn(\"⚠️ VULNERABILITY DETECTED: Endpoint allows unauthenticated operations.\");\r\n}\r\npm.test(\"Audit: Endpoint response received\", function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([200, 401, 403]);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/posts/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Security - Missing Auth Header Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {\r\n    console.warn(\"⚠️ VULNERABILITY DETECTED: Endpoint allows unauthenticated operations.\");\r\n}\r\npm.test(\"Audit: Endpoint response received\", function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([200, 401, 403]);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "04 - SQL Injection Testing",
      "item": [
        {
          "name": "Security - SQL Injection in Query Param",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Security Gate: System must safely handle SQL injection payloads\", function () {\r\n    // 1. Máy chủ không được văng lỗi hệ thống 500 Internal Server Error\r\n    pm.expect(pm.response.code).to.not.eql(500);\r\n\r\n    // 2. Không được để lộ thông tin nhạy cảm hoặc từ khóa lỗi của Database\r\n    const responseBody = pm.response.text().toLowerCase();\r\n    const dangerousSignatures = [\r\n        \"syntax error\", \r\n        \"sqlite3::\", \r\n        \"psycopg2\", \r\n        \"sql syntax\", \r\n        \"mysql_fetch\", \r\n        \"ora-\", \r\n        \"unclosed quotation mark\"\r\n    ];\r\n\r\n    dangerousSignatures.forEach(signature => {\r\n        pm.expect(responseBody).to.not.include(signature);\r\n    });\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "title",
                "value": "' OR '1'='1"
              }
            ],
            "url": {
              "raw": "{{base_url}}/posts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "05 - Security Misconfiguration",
      "item": [
        {
          "name": "Security - Headers & Fingerprinting Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.headers.has(\"X-Powered-By\")) {\r\n    console.warn(\"⚠️ MISCONFIGURATION: Server discloses tech stack via X-Powered-By.\");\r\n}\r\npm.test(\"Audit: Checked server security headers\", function () {\r\n    pm.expect(pm.response.code).to.eql(200);\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/posts/1",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts",
                "1"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "06 - Rate Limiting Testing",
      "item": [
        {
          "name": "Security - Rate Limit Bypass Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let currentLoop = pm.variables.get(\"loop_counter\") || 1;\r\ncurrentLoop = parseInt(currentLoop);\r\n\r\npm.test(`Audit: Rate limit load attempt ${currentLoop}`, function () {\r\n    pm.expect(pm.response.code).to.be.oneOf([200, 201, 429]);\r\n});\r\n\r\nif (currentLoop < 15) {\r\n    pm.variables.set(\"loop_counter\", currentLoop + 1);\r\n    pm.execution.setNextRequest(\"Security - Rate Limit Bypass Check\");\r\n} else {\r\n    pm.variables.unset(\"loop_counter\");\r\n    pm.execution.setNextRequest(null);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"title\": \"Flooding test\",\r\n  \"body\": \"Rate limit verification\",\r\n  \"userId\": 1\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/posts",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "posts"
              ]
            }
          },
          "response": []
        }
      ]
    }
